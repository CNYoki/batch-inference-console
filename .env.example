# ===================== 基础 =====================
DEBUG=false
# 生产必须换成长随机串：openssl rand -hex 32
# 注意：它同时用于派生模型 API Key 的加密密钥，更换后需在后台重新填写所有密钥
SECRET_KEY=please-change-me-to-a-long-random-string
# 前端来源（开发用 Vite，默认 5180；后端托管 dist 时可留空）
# 改前端端口时这里和 FRONTEND_BASE_URL 都要同步，否则 CORS 与 OIDC 回调会失败
CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# 登录完成后跳回的前端地址
FRONTEND_BASE_URL=http://localhost:5180

# ===================== 数据库 =====================
# MySQL 8（推荐，需 utf8mb4）
DATABASE_URL=mysql+asyncmy://batchinfer:CHANGE_ME@127.0.0.1:3306/batch_inference
# PostgreSQL
# DATABASE_URL=postgresql+asyncpg://batchinfer:CHANGE_ME@127.0.0.1:5432/batch_inference
# SQLite（仅本地试跑，不支持多 worker 并发写）
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===================== Redis（任务队列）=====================
REDIS_URL=redis://127.0.0.1:6379/0
# 带密码：redis://:password@host:port/0
# 同一个 Redis 上跑多套部署时，必须给每套配不同的前缀 ——
# 否则它们会抢同一个队列，而各自的 DATA_DIR 不同，抢错了就找不到输入文件
QUEUE_KEY_PREFIX=biu
# worker 租约秒数；超时未续租的任务会被自动回收重排
JOB_LEASE_SECONDS=60

# ===================== Worker =====================
# 单个 worker 进程同时处理几个任务
WORKER_MAX_CONCURRENT_JOBS=4
# 单个任务默认的条目并发（可被模型配置 / 任务参数覆盖）
DEFAULT_ITEM_CONCURRENCY=8
RESULT_FLUSH_SIZE=200

# ===================== 存储与限额 =====================
DATA_DIR=./data
MAX_UPLOAD_MB=512
MAX_ITEMS_PER_JOB=500000

# ===================== 本地账号 =====================
LOCAL_AUTH_ENABLED=true
# 首次启动时创建的管理员；已存在则不会覆盖密码。创建后建议置空
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ===================== OIDC 统一登录 =====================
OIDC_ENABLED=false
OIDC_DISPLAY_NAME=统一登录
# 例：https://pocket-id.example.com / https://keycloak.example.com/realms/master
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# 需在 IdP 里登记为合法回调地址
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
# claim 映射
OIDC_USERNAME_CLAIM=preferred_username
OIDC_EMAIL_CLAIM=email
OIDC_NAME_CLAIM=name
# 属于该组的用户自动获得管理员角色；留空则不做组同步
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
# 首次登录是否自动建号（false 则需管理员先建同名账号）
OIDC_AUTO_CREATE_USER=true

# ===================== Cookie =====================
# 走 HTTPS 时务必设为 true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_TTL_HOURS=12
